{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConsoleLogging": {
    "MinimumLevel": "Debug",
    "ShowTimestamp": true,
    "ShowContext": true,
    "UseColors": true
  },
  "Game": {
    "ApplicationName": "NexusRealms - Prelude",
    "Version": "1.0.0",
    "UserDataPath": "%APPDATA%\\NexusRealms\\Prelude",
    "DefaultSettings": {
      "Graphics": {
        "DefaultResolutionWidth": 1920,
        "DefaultResolutionHeight": 1080,
        "DefaultFullscreen": true,
        "DefaultVSync": true,
        "DefaultGraphicsQuality": "High"
      },
      "Audio": {
        "DefaultMasterVolume": 1.0,
        "DefaultMusicVolume": 0.8,
        "DefaultSfxVolume": 1.0
      },
      "Input": {
        "DefaultMouseSensitivity": 1.0,
        "DefaultGamepadSensitivity": 1.0
      }
    }
  },
  "JsonSerialization": {
    "PropertyNamingPolicy": "CamelCase",
    "WriteIndented": true,
    "PropertyNameCaseInsensitive": true
  }
}
